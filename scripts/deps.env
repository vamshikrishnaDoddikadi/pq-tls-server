# =========================================================================
# Pinned third-party dependencies — the single source of truth used by
# scripts/build-deps.sh, the Dockerfile and CI. Every download is verified
# against the commit / checksum below.
# =========================================================================

# liboqs: post-quantum algorithms (ML-KEM / ML-DSA).
# 0.15.0 is the release oqs-provider 0.11.0 is certified against. Only the
# algorithms this project uses are compiled (OQS_MINIMAL_BUILD), which also
# keeps unused code with known advisories (XMSS, HQC) out of the binary.
LIBOQS_VERSION=0.15.0
LIBOQS_COMMIT=97f6b86b1b6d109cfd43cf276ae39c2e776aed80
LIBOQS_ALGS="KEM_ml_kem_512;KEM_ml_kem_768;KEM_ml_kem_1024;SIG_ml_dsa_44;SIG_ml_dsa_65;SIG_ml_dsa_87"

# oqs-provider: PQ TLS groups for OpenSSL 3.0-3.4.
# Not needed with OpenSSL >= 3.5, which implements ML-KEM hybrids natively.
OQS_PROVIDER_VERSION=0.11.0
OQS_PROVIDER_COMMIT=a635e341d6a4624d9bba36d158804762f316fe5e

# Chart.js for the management dashboard (from the immutable npm tarball).
CHARTJS_VERSION=4.4.1
CHARTJS_TARBALL_SHA256=9ee0a0470ab0888f95f2cd380b219c9e31a0a64a8356cea970f49bbfa829fd83
